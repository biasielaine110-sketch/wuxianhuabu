{
  "name": "ai",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=ai-frontend",
    "typecheck": "npm run typecheck --workspace=ai-frontend",
    "dev-frontend": "npm run dev --prefix frontend",
    "dev": "npm run dev-frontend"
  },
  "allowScripts": {
    "protobufjs": true,
    "fsevents": true
  },
  "packageManager": "npm@11.16.2",
  "engines": {
    "node": "24.x"
  }
}
